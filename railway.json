{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "buildEnvironment": "V3"
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "startCommand": "/bin/sh -c \"alpaca-mcp-server serve --transport streamable-http --host 0.0.0.0 --port $PORT & uvicorn alpaca_rule_engine.control:app --host 0.0.0.0 --port 8080\"",
    "sleepApplication": false,
    "useLegacyStacker": false,
    "ipv6EgressEnabled": false,
    "restartPolicyType": "ON_FAILURE",
    "healthcheckTimeout": 60,
    "restartPolicyMaxRetries": 10
  }
}
